# Maintainer: funkypitt <pierregallaz@gmail.com>
# Arch / Manjaro: cd packaging && makepkg -si
# Scanners that do not speak eSCL (AirScan) need NAPS2 (AUR: naps2-bin, or the Flatpak com.naps2.Naps2).
pkgname=readers-scanner
pkgver=1.0.6
pkgrel=1
pkgdesc="One-click scanning to searchable PDFs, filed in the folders shared with the phone"
arch=('any')
url="https://github.com/funkypitt/readers-scanner-desktop"
license=('MIT')
depends=('python' 'python-pyqt5' 'python-requests' 'python-pillow' 'python-numpy' 'python-zeroconf' 'tesseract' 'poppler')
optdepends=('ipp-usb: scanners on USB asked directly' 'naps2-bin: for the scanners that do not speak eSCL (AirScan)' 'sane: finds those scanners faster')
source=("$pkgname-$pkgver.tar.gz::https://github.com/funkypitt/readers-scanner-desktop/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/readers-scanner-desktop-$pkgver"
  install -Dm755 readers_scanner.py "$pkgdir/usr/lib/readers-scanner/readers_scanner.py"
  for f in packaging/fonts/*; do install -Dm644 "$f" "$pkgdir/usr/lib/readers-scanner/fonts/$(basename "$f")"; done
  install -Dm644 packaging/readers-scanner.png "$pkgdir/usr/lib/readers-scanner/readers-scanner.png"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/readers-scanner" <<'SH'
#!/bin/sh
exec python3 /usr/lib/readers-scanner/readers_scanner.py "$@"
SH
  install -Dm644 packaging/readers-scanner.desktop "$pkgdir/usr/share/applications/readers-scanner.desktop"
  install -Dm644 packaging/readers-scanner.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/readers-scanner.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
